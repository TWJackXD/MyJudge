# Judge0（RapidAPI）
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=

# JWT（請改成足夠隨機、至少 32 字元的密鑰）
JWT_SECRET=

# 排程清理過期 token 用（Vercel Cron / 手動呼叫皆需此密鑰）
CRON_SECRET=

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# 建議使用 service_role key（僅伺服端，勿暴露到前端）
SUPABASE_KEY=
# 若未設定 SUPABASE_KEY，也可改用：
# SUPABASE_SERVICE_ROLE_KEY=
